@@ -0,0 +1,433 @@
+/* ---------- shared buttons ---------- */
+.yes {
+  height: 40px;
+  padding: 0 18px;
+  border-radius: var(--radius-pill);
+  background: var(--color-accent);
+  color: var(--color-on-accent);
+  font-size: 13px;
+  font-weight: 700;
+  white-space: nowrap;
+  box-shadow: 0 10px 18px -12px rgba(163, 36, 59, 0.9);
+  transition:
+    transform 0.15s,
+    background 0.15s;
+}
+
+.yes:hover {
+  background: var(--color-accent-strong);
+  transform: translateY(-1px);
+}
+
+.peek {
+  height: 40px;
+  padding: 0 16px;
+  display: inline-grid;
+  place-items: center;
+  border-radius: var(--radius-pill);
+  border: 1px solid var(--color-border);
+  background: var(--color-panel);
+  color: var(--color-text);
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.close {
+  position: absolute;
+  top: 18px;
+  left: 12px;
+  width: 28px;
+  height: 28px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  font-size: 20px;
+  line-height: 1;
+  color: var(--color-muted);
+  background: rgba(90, 45, 30, 0.06);
+  z-index: 2;
+}
+
+.close:hover {
+  color: var(--color-accent);
+}
+
+/* ---------- "Fresh from the oven" toast ---------- */
+.oven {
+  position: fixed;
+  z-index: 50;
+  left: 24px;
+  bottom: calc(24px + env(safe-area-inset-bottom));
+  width: 380px;
+  max-width: calc(100vw - 24px);
+  padding: 22px 18px 16px;
+  border-radius: 24px;
+  background: var(--color-panel);
+  border: 1px solid var(--color-border);
+  box-shadow: 0 24px 50px -20px rgba(59, 31, 26, 0.45);
+  overflow: hidden;
+  animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+}
+
+@keyframes popIn {
+  from {
+    opacity: 0;
+    transform: translateY(40px) scale(0.85) rotate(-3deg);
+  }
+}
+
+/* tiny striped awning, matching the site's top awning */
+.ovenAwning {
+  position: absolute;
+  inset: 0 0 auto;
+  height: 12px;
+  background: linear-gradient(90deg, var(--color-accent) 0 50%, #fcefdc 50% 100%) 0 0 / 28px 100%;
+  -webkit-mask: linear-gradient(#000 0 5px, transparent 5px), radial-gradient(circle at 7px 5px, #000 6.5px, transparent 7px) 0 0 / 14px 12px;
+  mask: linear-gradient(#000 0 5px, transparent 5px), radial-gradient(circle at 7px 5px, #000 6.5px, transparent 7px) 0 0 / 14px 12px;
+}
+
+.ovenBody {
+  display: flex;
+  gap: 14px;
+  align-items: center;
+}
+
+.tray {
+  position: relative;
+  flex: 0 0 auto;
+  width: 92px;
+  height: 92px;
+  border-radius: 50%;
+  background: radial-gradient(circle at 50% 40%, #fff, #f6e9d6 70%);
+  box-shadow: inset 0 -4px 0 rgba(90, 45, 30, 0.06);
+}
+
+.tray img {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 130px;
+  height: 130px;
+  max-width: none;
+  object-fit: contain;
+  translate: -50% -52%;
+  animation: wiggle 1.8s ease-in-out infinite;
+}
+
+@keyframes wiggle {
+  0%,
+  100% {
+    transform: rotate(-5deg) translateY(0);
+  }
+  50% {
+    transform: rotate(5deg) translateY(-5px);
+  }
+}
+
+.steam {
+  position: absolute;
+  top: -12px;
+  left: 50%;
+  translate: -50% 0;
+  display: flex;
+  gap: 5px;
+  z-index: 1;
+}
+
+.steam i {
+  width: 4px;
+  height: 16px;
+  border-radius: 4px;
+  background: rgba(163, 36, 59, 0.35);
+  animation: steam 1.4s ease-in-out infinite;
+}
+
+.steam i:nth-child(2) {
+  animation-delay: 0.2s;
+  height: 20px;
+}
+
+.steam i:nth-child(3) {
+  animation-delay: 0.4s;
+}
+
+@keyframes steam {
+  0%,
+  100% {
+    opacity: 0;
+    transform: translateY(6px) scaleY(0.5);
+  }
+  50% {
+    opacity: 1;
+    transform: translateY(-4px) scaleY(1);
+  }
+}
+
+.ovenText {
+  flex: 1;
+  min-width: 0;
+}
+
+.ovenTitle {
+  font-size: 18px;
+  font-weight: 800;
+  color: var(--color-accent);
+}
+
+.ovenCopy {
+  margin-top: 4px;
+  font-size: 13px;
+  line-height: 1.8;
+  color: var(--color-text);
+}
+
+.actions {
+  margin-top: 10px;
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.bell {
+  margin-top: 14px;
+  width: 100%;
+  height: 38px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  border-radius: var(--radius-pill);
+  border: 1.5px dashed rgba(163, 36, 59, 0.45);
+  color: var(--color-accent);
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.bell:hover:not(:disabled) {
+  background: var(--color-accent-tint);
+}
+
+.bell:disabled {
+  opacity: 0.6;
+  cursor: default;
+}
+
+.bellIcon {
+  display: inline-block;
+  animation: ring 2.4s ease-in-out infinite;
+  transform-origin: 50% 10%;
+}
+
+@keyframes ring {
+  0%,
+  60%,
+  100% {
+    transform: rotate(0);
+  }
+  65% {
+    transform: rotate(18deg);
+  }
+  72% {
+    transform: rotate(-16deg);
+  }
+  79% {
+    transform: rotate(10deg);
+  }
+  86% {
+    transform: rotate(-6deg);
+  }
+}
+
+.hint {
+  margin-top: 12px;
+  font-size: 11px;
+  color: var(--color-muted);
+  text-align: center;
+}
+
+/* "added from notification" flash */
+.flash {
+  position: fixed;
+  z-index: 60;
+  left: 50%;
+  top: 120px;
+  translate: -50% 0;
+  padding: 12px 22px;
+  border-radius: var(--radius-pill);
+  background: var(--color-accent);
+  color: var(--color-on-accent);
+  font-size: 14px;
+  font-weight: 700;
+  box-shadow: 0 16px 30px -16px rgba(163, 36, 59, 0.9);
+  animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+}
+
+/* ---------- Install sheet ---------- */
+.sheetWrap {
+  position: fixed;
+  z-index: 55;
+  inset: auto 0 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 0 12px calc(12px + env(safe-area-inset-bottom));
+  pointer-events: none;
+}
+
+.sheet {
+  position: relative;
+  width: 440px;
+  max-width: 100%;
+  padding: 14px 20px 20px;
+  border-radius: 28px;
+  background: var(--color-panel);
+  border: 1px solid var(--color-border);
+  box-shadow: 0 -10px 50px -20px rgba(59, 31, 26, 0.5);
+  pointer-events: auto;
+  animation: slideUp 0.55s cubic-bezier(0.34, 1.4, 0.64, 1) both;
+}
+
+@keyframes slideUp {
+  from {
+    transform: translateY(110%);
+  }
+}
+
+.grip {
+  display: block;
+  width: 44px;
+  height: 5px;
+  margin: 0 auto 14px;
+  border-radius: 5px;
+  background: rgba(90, 45, 30, 0.15);
+}
+
+.sheet .close {
+  top: 14px;
+}
+
+.sheetHead {
+  display: flex;
+  gap: 14px;
+  align-items: center;
+}
+
+.appIcon {
+  width: 64px;
+  height: 64px;
+  border-radius: 16px;
+  box-shadow: 0 10px 20px -10px rgba(163, 36, 59, 0.8);
+  animation: hop 2.2s ease-in-out infinite;
+}
+
+@keyframes hop {
+  0%,
+  70%,
+  100% {
+    transform: translateY(0);
+  }
+  80% {
+    transform: translateY(-8px) rotate(-6deg);
+  }
+  90% {
+    transform: translateY(0) rotate(3deg);
+  }
+}
+
+.sheetTitle {
+  font-size: 17px;
+  font-weight: 800;
+}
+
+.sheetCopy {
+  margin-top: 4px;
+  font-size: 12px;
+  line-height: 1.8;
+  color: var(--color-muted);
+}
+
+.sheetActions {
+  margin-top: 16px;
+  display: flex;
+  gap: 8px;
+}
+
+.sheetActions .yes {
+  flex: 1;
+  height: 46px;
+  font-size: 14px;
+}
+
+.steps {
+  margin: 16px 0 0;
+  padding: 0;
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  font-size: 13px;
+}
+
+.steps li {
+  display: grid;
+  grid-template-columns: 24px 1fr;
+  align-items: center;
+  gap: 10px;
+  line-height: 1.8;
+}
+
+.share {
+  display: inline-block;
+  vertical-align: middle;
+  margin: 0 2px;
+}
+
+.stepNo {
+  width: 24px;
+  height: 24px;
+  border-radius: 50%;
+  display: inline-grid;
+  place-items: center;
+  background: var(--color-accent-tint);
+  color: var(--color-accent);
+  font-size: 12px;
+  font-weight: 800;
+}
+
+.share {
+  color: #0a84ff;
+}
+
+.pointer {
+  margin-top: 6px;
+  font-size: 22px;
+  color: var(--color-accent);
+  animation: point 1s ease-in-out infinite alternate;
+}
+
+@keyframes point {
+  to {
+    transform: translateY(6px);
+  }
+}
+
+@media (max-width: 700px) {
+  .oven {
+    left: 12px;
+    right: 12px;
+    width: auto;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .oven,
+  .sheet,
+  .flash,
+  .tray img,
+  .steam i,
+  .bellIcon,
+  .appIcon,
+  .pointer {
+    animation: none;
+  }
+}
diff --git a/src/pwa/PwaUi.tsx b/src/pwa/PwaUi.tsx
new file mode 100644
index 0000000..8a149d5
--- /dev/null
+++ b/src/pwa/PwaUi.tsx
@@ -0,0 +1,288 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { Link, useLocation, useNavigate } from 'react-router-dom';
+import { getProduct, products, type Product } from '../data/products';
+import { useCart } from '../state/cart';
+import { asset } from '../lib/format';
+import {
+  askNotificationPermission,
+  isIOS,
+  isStandalone,
+  notificationsAllowed,
+  notificationsSupported,
+  showOvenNotification,
+  store,
+  type InstallPromptEvent,
+} from './pwa';
+import s from './PwaUi.module.css';
+
+const OVEN_DELAY = 6_000; // first "fresh from the oven" toast
+const INSTALL_DELAY = 9_000; // install sheet, after the toast is gone
+const INSTALL_SNOOZE_DAYS = 7;
+
+// Pages where popups would get in the way of paying.
+const QUIET = /^\/(checkout|order)/;
+
+/** Pain au chocolat first, then a different pastry on every later visit. */
+function nextFreshPastry(): Product {
+  const first = getProduct('pain-au-chocolat') ?? products[0];
+  const seen = Number(store.get('oven-count') ?? '0');
+  store.set('oven-count', String(seen + 1));
+  if (seen === 0) return first;
+  return products[seen % products.length];
+}
+
+const ovenCopy = (p: Product) => ({
+  title: 'سلااااام! 👋',
+  body: `${p.name} همین الان از فر دراومد؛ داغِ داغ! میخوایش؟`,
+});
+
+export function PwaUi() {
+  const { pathname, search } = useLocation();
+  const navigate = useNavigate();
+  const { add } = useCart();
+
+  /* ---------- "Fresh from the oven" toast ---------- */
+  const [pastry, setPastry] = useState<Product | null>(null);
+  const [added, setAdded] = useState(false);
+  const [bell, setBell] = useState<'idle' | 'on' | 'blocked'>(notificationsAllowed() ? 'on' : 'idle');
+  const [ovenDone, setOvenDone] = useState(false);
+
+  useEffect(() => {
+    if (store.get('oven-shown', true)) {
+      setOvenDone(true);
+      return;
+    }
+    const t = window.setTimeout(() => {
+      if (QUIET.test(window.location.pathname)) return setOvenDone(true);
+      store.set('oven-shown', '1', true);
+      const p = nextFreshPastry();
+      // App in the background with notifications on → real system notification.
+      if (document.hidden && notificationsAllowed()) {
+        showOvenNotification({ ...ovenCopy(p), url: `/product/${p.slug}`, slug: p.slug, image: asset(p.images.portrait) });
+        setOvenDone(true);
+      } else {
+        setPastry(p);
+      }
+    }, OVEN_DELAY);
+    return () => window.clearTimeout(t);
+  }, []);
+
+  const closeOven = useCallback(() => {
+    setPastry(null);
+    setAdded(false);
+    setOvenDone(true);
+  }, []);
+
+  const addPastry = () => {
+    if (!pastry) return;
+    add(pastry.slug);
+    setAdded(true);
+    window.setTimeout(closeOven, 1800);
+  };
+
+  const turnOnBell = async () => {
+    const ok = await askNotificationPermission();
+    setBell(ok ? 'on' : 'blocked');
+    if (ok)
+      showOvenNotification({
+        title: 'حله! 🎉🔔',
+        body: 'از این به بعد هر وقت یه سینی شیرینی داغ از فر دراومد، همین‌جا خبرت می‌کنیم.',
+        tag: 'welcome',
+      });
+  };
+
+  /* ---------- Notification "add to box" action → /product/:slug?add=1 ---------- */
+  const [flash, setFlash] = useState<string | null>(null);
+  useEffect(() => {
+    const m = pathname.match(/^\/product\/([^/]+)$/);
+    if (!m || !new URLSearchParams(search).has('add')) return;
+    const p = getProduct(m[1]);
+    if (p) {
+      add(p.slug);
+      setFlash(`${p.name} رفت تو جعبه! 🧺`);
+      window.setTimeout(() => setFlash(null), 2600);
+    }
+    navigate(pathname, { replace: true });
+  }, [pathname, search, add, navigate]);
+
+  /* ---------- Install sheet ---------- */
+  const deferred = useRef<InstallPromptEvent | null>(null);
+  const [canPrompt, setCanPrompt] = useState(false);
+  const [sheet, setSheet] = useState(false);
+  const ios = isIOS();
+
+  useEffect(() => {
+    const onPrompt = (e: Event) => {
+      e.preventDefault(); // we show our own, cuter prompt
+      deferred.current = e as InstallPromptEvent;
+      setCanPrompt(true);
+    };
+    const onInstalled = () => {
+      setSheet(false);
+      store.set('install-snooze', String(Date.now() + 3650 * 864e5));
+    };
+    window.addEventListener('beforeinstallprompt', onPrompt);
+    window.addEventListener('appinstalled', onInstalled);
+    return () => {
+      window.removeEventListener('beforeinstallprompt', onPrompt);
+      window.removeEventListener('appinstalled', onInstalled);
+    };
+  }, []);
+
+  useEffect(() => {
+    if (!ovenDone || isStandalone() || !(canPrompt || ios)) return;
+    if (Number(store.get('install-snooze') ?? 0) > Date.now()) return;
+    const t = window.setTimeout(() => {
+      if (!QUIET.test(window.location.pathname)) setSheet(true);
+    }, INSTALL_DELAY);
+    return () => window.clearTimeout(t);
+  }, [ovenDone, canPrompt, ios]);
+
+  const snooze = () => {
+    store.set('install-snooze', String(Date.now() + INSTALL_SNOOZE_DAYS * 864e5));
+    setSheet(false);
+  };
+
+  const install = async () => {
+    const e = deferred.current;
+    if (!e) return;
+    await e.prompt();
+    const { outcome } = await e.userChoice;
+    deferred.current = null;
+    setCanPrompt(false);
+    if (outcome === 'accepted') setSheet(false);
+    else snooze();
+  };
+
+  // On iPhone, notifications only work once the site is added to the home screen.
+  const bellPossible = notificationsSupported() && !(ios && !isStandalone());
+
+  return (
+    <>
+      {pastry && (
+        <aside className={s.oven} role="status" aria-live="polite">
+          <div className={s.ovenAwning} aria-hidden />
+          <button className={s.close} onClick={closeOven} aria-label="بستن">
+            ×
+          </button>
+
+          <div className={s.ovenBody}>
+            <div className={s.tray} aria-hidden>
+              <span className={s.steam}>
+                <i />
+                <i />
+                <i />
+              </span>
+              <img src={asset(pastry.images.thumb ?? pastry.images.portrait)} alt="" />
+            </div>
+
+            <div className={s.ovenText}>
+              {added ? (
+                <>
+                  <p className={s.ovenTitle}>رفت تو جعبه! 🎉</p>
+                  <p className={s.ovenCopy}>نوش جان؛ هر وقت خواستی از سبد خرید تکمیلش کن.</p>
+                </>
+              ) : (
+                <>
+                  <p className={s.ovenTitle}>{ovenCopy(pastry).title}</p>
+                  <p className={s.ovenCopy}>{ovenCopy(pastry).body}</p>
+                  <div className={s.actions}>
+                    <button className={s.yes} onClick={addPastry}>
+                      آره، بذار تو جعبه! 🧺
+                    </button>
+                    <Link to={`/product/${pastry.slug}`} className={s.peek} onClick={closeOven}>
+                      ببینمش
+                    </Link>
+                  </div>
+                </>
+              )}
+            </div>
+          </div>
+
+          {!added && bellPossible && bell !== 'on' && (
+            <button className={s.bell} onClick={turnOnBell} disabled={bell === 'blocked'}>
+              <span className={s.bellIcon} aria-hidden>
+                🔔
+              </span>
+              {bell === 'blocked'
+                ? 'اعلان‌ها توی تنظیمات مرورگر بسته‌ست'
+                : 'دفعهٔ بعد رو گوشیم خبرم کن'}
+            </button>
+          )}
+          {!added && ios && !isStandalone() && (
+            <p className={s.hint}>برای اعلان روی آیفون، اول چوکوبار رو به صفحهٔ اصلی اضافه کن 📲</p>
+          )}
+        </aside>
+      )}
+
+      {flash && (
+        <p className={s.flash} role="status">
+          {flash}
+        </p>
+      )}
+
+      {sheet && (
+        <div className={s.sheetWrap} role="dialog" aria-modal="false" aria-labelledby="install-title">
+          <section className={s.sheet}>
+            <span className={s.grip} aria-hidden />
+            <button className={s.close} onClick={snooze} aria-label="بستن">
+              ×
+            </button>
+
+            <div className={s.sheetHead}>
+              <img src="/pwa/icon-192.png" alt="" className={s.appIcon} />
+              <div>
+                <h2 id="install-title" className={s.sheetTitle}>
+                  چوکوبار رو بذار رو گوشیت! 📲
+                </h2>
+                <p className={s.sheetCopy}>بدون استور، مثل یه اپ واقعی: آیکون روی صفحه، باز شدن سریع و خبرِ داغ‌ترین شیرینی‌ها.</p>
+              </div>
+            </div>
+
+            {ios && !canPrompt ? (
+              <ol className={s.steps}>
+                <li>
+                  <span className={s.stepNo}>۱</span>
+                  <span>
+                    پایین صفحه دکمهٔ اشتراک‌گذاری <ShareIcon /> رو بزن
+                  </span>
+                </li>
+                <li>
+                  <span className={s.stepNo}>۲</span>
+                  <span>گزینهٔ «Add to Home Screen» یا «افزودن به صفحهٔ اصلی» رو انتخاب کن</span>
+                </li>
+                <li>
+                  <span className={s.stepNo}>۳</span>
+                  <span>بالا سمت راست «Add» رو بزن؛ تموم! 🎉</span>
+                </li>
+              </ol>
+            ) : (
+              <div className={s.sheetActions}>
+                <button className={s.yes} onClick={install}>
+                  نصبش کن
+                </button>
+                <button className={s.peek} onClick={snooze}>
+                  بعداً
+                </button>
+              </div>
+            )}
+          </section>
+          {ios && !canPrompt && (
+            <span className={s.pointer} aria-hidden>
+              ⬇
+            </span>
+          )}
+        </div>
+      )}
+    </>
+  );
+}
+
+function ShareIcon() {
+  return (
+    <svg className={s.share} viewBox="0 0 24 24" width="20" height="20" aria-label="اشتراک‌گذاری">
+      <path d="M12 3v12M8 7l4-4 4 4" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
+      <path d="M6 11H5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1h-1" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" />
+    </svg>
+  );
+}
