@@ -0,0 +1,331 @@
+/* ─────────────────────────────────────────────
+   جعبهٔ شیرینی باز + بسته‌های سلفونی با روبان زرد
+   ───────────────────────────────────────────── */
+.box {
+  --paper: #fffdf9;
+  --paper-2: #f3ebdf;
+  --paper-3: #e6dacb;
+  --ribbon: #f6c42f;
+  --ribbon-dark: #d9a20f;
+  position: relative;
+  width: 100%;
+  padding-top: 92px; /* room for the open lid */
+  isolation: isolate;
+}
+
+/* Open lid standing up behind the box, tilted back in perspective */
+.lid {
+  position: absolute;
+  inset: 0 6% auto;
+  height: 132px;
+  z-index: -1;
+  clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%);
+  background:
+    linear-gradient(180deg, rgba(90, 45, 30, 0.1), transparent 40%),
+    linear-gradient(90deg, var(--paper-3), var(--paper) 18%, var(--paper) 82%, var(--paper-3));
+  border-radius: 8px 8px 0 0;
+  display: flex;
+  justify-content: center;
+  padding-top: 22px;
+}
+
+/* striped awning trim on the lid edge */
+.lid::before {
+  content: '';
+  position: absolute;
+  inset: 0 0 auto;
+  height: 10px;
+  background: linear-gradient(90deg, var(--color-accent) 0 50%, #fcefdc 50% 100%) 0 0 / 24px 100%;
+  opacity: 0.9;
+}
+
+.lidPrint {
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.5px;
+  color: rgba(163, 36, 59, 0.55);
+}
+
+/* Inside of the box: back wall + floor */
+.inside {
+  position: relative;
+  min-height: 210px;
+  padding: 18px 26px 70px;
+  border-radius: 10px 10px 0 0;
+  background:
+    linear-gradient(180deg, #e9dfd1 0%, #f4ece1 40%, #efe5d7 100%);
+  box-shadow:
+    inset 0 18px 22px -14px rgba(90, 45, 30, 0.35),
+    inset 14px 0 18px -14px rgba(90, 45, 30, 0.25),
+    inset -14px 0 18px -14px rgba(90, 45, 30, 0.25);
+}
+
+.empty {
+  padding-top: 40px;
+  text-align: center;
+  font-size: 15px;
+  font-weight: 700;
+  line-height: 1.9;
+  color: var(--color-muted);
+}
+
+.packets {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
+  gap: 18px 14px;
+  justify-items: center;
+}
+
+/* ---------- Cellophane packet ---------- */
+.packet {
+  position: relative;
+  width: 120px;
+  height: 150px;
+  rotate: var(--tilt);
+  transform-origin: 50% 100%;
+}
+
+.bag {
+  position: absolute;
+  inset: 30px 0 0;
+  border-radius: 22px 22px 14px 14px / 30px 30px 14px 14px;
+  overflow: hidden;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.18) 45%, rgba(255, 255, 255, 0.4));
+  border: 1.5px solid rgba(255, 255, 255, 0.9);
+  box-shadow:
+    inset 0 0 14px rgba(255, 255, 255, 0.85),
+    0 10px 14px -10px rgba(59, 31, 26, 0.55);
+}
+
+.bag img {
+  position: absolute;
+  inset: -42%;
+  width: 184%;
+  height: 184%;
+  max-width: none;
+  object-fit: contain;
+  z-index: -1;
+}
+
+/* a second packet peeking behind when qty > 1 */
+.behind {
+  inset: 18px -8px 6px 10px;
+  rotate: 7deg;
+  opacity: 0.75;
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.7), rgba(235, 215, 190, 0.6));
+  z-index: -1;
+}
+
+/* glossy plastic reflections + crinkles */
+.shine {
+  position: absolute;
+  inset: 0;
+  background:
+    linear-gradient(115deg, transparent 22%, rgba(255, 255, 255, 0.75) 28%, transparent 36%),
+    linear-gradient(115deg, transparent 52%, rgba(255, 255, 255, 0.45) 56%, transparent 61%),
+    repeating-linear-gradient(170deg, transparent 0 9px, rgba(255, 255, 255, 0.18) 9px 10px);
+  mix-blend-mode: screen;
+}
+
+/* gathered, twisted top of the bag */
+.neck {
+  position: absolute;
+  top: 0;
+  left: 50%;
+  width: 58px;
+  height: 34px;
+  translate: -50% 0;
+  clip-path: polygon(0 0, 18% 8%, 34% 0, 50% 7%, 66% 0, 82% 8%, 100% 0, 66% 100%, 34% 100%);
+  background:
+    linear-gradient(90deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.95) 35%, rgba(240, 232, 222, 0.75) 50%, rgba(255, 255, 255, 0.95) 65%, rgba(255, 255, 255, 0.5)),
+    repeating-linear-gradient(80deg, transparent 0 5px, rgba(200, 185, 170, 0.25) 5px 6px);
+  opacity: 0.92;
+  filter: drop-shadow(0 1px 1px rgba(59, 31, 26, 0.2));
+}
+
+/* yellow satin bow */
+.bow {
+  position: absolute;
+  top: 26px;
+  left: 50%;
+  width: 0;
+  height: 0;
+  z-index: 2;
+  scale: 1.3;
+}
+
+.bow i {
+  position: absolute;
+  display: block;
+  background: linear-gradient(180deg, var(--ribbon), var(--ribbon-dark));
+}
+
+.loopL,
+.loopR {
+  width: 20px;
+  height: 12px;
+  top: -6px;
+  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
+  box-shadow: inset 0 -3px 0 rgba(150, 100, 0, 0.25);
+}
+
+.loopL {
+  left: -21px;
+  rotate: -14deg;
+}
+
+.loopR {
+  left: 1px;
+  rotate: 14deg;
+}
+
+.tailL,
+.tailR {
+  width: 6px;
+  height: 18px;
+  top: 0;
+  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
+}
+
+.tailL {
+  left: -7px;
+  rotate: 22deg;
+}
+
+.tailR {
+  left: 1px;
+  rotate: -22deg;
+}
+
+.knot {
+  width: 9px;
+  height: 9px;
+  top: -4px;
+  left: -4.5px;
+  border-radius: 50%;
+  background: var(--ribbon-dark) !important;
+  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.5);
+}
+
+.qty {
+  position: absolute;
+  top: 34px;
+  left: -6px;
+  z-index: 3;
+  padding: 2px 8px;
+  border-radius: var(--radius-pill);
+  background: var(--color-accent);
+  color: var(--color-on-accent);
+  font-size: 12px;
+  font-weight: 800;
+  rotate: -8deg;
+  box-shadow: 0 4px 8px -4px rgba(163, 36, 59, 0.9);
+}
+
+/* the pastry that was just added drops in */
+.fresh {
+  animation: drop 0.9s cubic-bezier(0.3, 1.4, 0.5, 1) both;
+}
+
+@keyframes drop {
+  0% {
+    transform: translateY(-160px) rotate(-14deg);
+    opacity: 0;
+  }
+  55% {
+    transform: translateY(6px) rotate(4deg);
+    opacity: 1;
+  }
+  75% {
+    transform: translateY(-6px) rotate(-2deg);
+  }
+}
+
+/* ---------- Front wall of the box ---------- */
+.front {
+  position: relative;
+  height: 92px;
+  margin-top: -70px; /* hides the bottom of the packets, like real box walls */
+  border-radius: 4px 4px 12px 12px;
+  background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
+  box-shadow:
+    inset 0 2px 0 #fff,
+    inset 0 -6px 10px -6px rgba(90, 45, 30, 0.18),
+    0 22px 30px -18px rgba(59, 31, 26, 0.5);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 2;
+}
+
+.trim {
+  position: absolute;
+  inset: 0 0 auto;
+  height: 7px;
+  border-radius: 4px 4px 0 0;
+  background: linear-gradient(90deg, var(--color-accent) 0 50%, #fcefdc 50% 100%) 0 0 / 24px 100%;
+}
+
+.seal {
+  width: 62px;
+  height: 62px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  background: #fff;
+  border: 3px solid var(--color-accent);
+  box-shadow:
+    0 0 0 3px #fff,
+    0 4px 8px -2px rgba(59, 31, 26, 0.35);
+  rotate: -6deg;
+}
+
+.seal img {
+  width: 70%;
+  height: 70%;
+  object-fit: contain;
+}
+
+/* little round "thank you" sticker, like the photo */
+.thanks {
+  position: absolute;
+  left: 22px;
+  top: 18px;
+  width: 58px;
+  height: 58px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  text-align: center;
+  font-size: 10px;
+  font-weight: 800;
+  line-height: 1.4;
+  color: var(--color-text);
+  background: #fff;
+  border: 1.5px solid rgba(59, 31, 26, 0.7);
+  box-shadow: 0 0 0 3px #fff, 0 3px 6px -2px rgba(59, 31, 26, 0.3);
+  rotate: 12deg;
+}
+
+@media (max-width: 520px) {
+  .packets {
+    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
+    gap: 22px 10px;
+  }
+  .packet {
+    width: 96px;
+    height: 124px;
+  }
+  .thanks {
+    display: none;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .fresh {
+    animation: none;
+  }
+}
diff --git a/src/components/box/PastryBox.tsx b/src/components/box/PastryBox.tsx
new file mode 100644
index 0000000..45012cc
--- /dev/null
+++ b/src/components/box/PastryBox.tsx
@@ -0,0 +1,67 @@
+import type { CartLine } from '../../state/cart';
+import { asset, faNumber } from '../../lib/format';
+import s from './PastryBox.module.css';
+
+const img = (l: CartLine) => asset(l.product.images.cart ?? l.product.images.thumb ?? l.product.images.portrait);
+
+/**
+ * An open bakery box (lid up, like a cake-box mockup) with every pastry in the
+ * cart wrapped in a cellophane bag tied with a yellow ribbon.
+ * `fresh` marks the slug that was just added so it drops in with a bounce.
+ */
+export function PastryBox({ lines, fresh }: { lines: CartLine[]; fresh?: string | null }) {
+  return (
+    <div className={s.box}>
+      <div className={s.lid} aria-hidden>
+        <span className={s.lidPrint}>چوکوبار • تازه از فر</span>
+      </div>
+
+      <div className={s.inside}>
+        {lines.length === 0 ? (
+          <p className={s.empty}>
+            جعبه‌ت هنوز خالیه! 🥺
+            <br />
+            یه شیرینی بنداز توش.
+          </p>
+        ) : (
+          <ul className={s.packets}>
+            {lines.map((l, i) => (
+              <li
+                key={l.product.slug}
+                className={`${s.packet} ${fresh === l.product.slug ? s.fresh : ''}`}
+                style={{ ['--tilt' as string]: `${((i * 37) % 9) - 4}deg` }}
+              >
+                {l.qty > 1 && <span className={`${s.bag} ${s.behind}`} aria-hidden />}
+                <span className={s.neck} aria-hidden />
+                <span className={s.bag}>
+                  <img src={img(l)} alt={l.product.name} />
+                  <span className={s.shine} aria-hidden />
+                </span>
+                <span className={s.bow} aria-hidden>
+                  <i className={s.loopL} />
+                  <i className={s.loopR} />
+                  <i className={s.tailL} />
+                  <i className={s.tailR} />
+                  <i className={s.knot} />
+                </span>
+                {l.qty > 1 && <span className={s.qty}>×{faNumber(l.qty)}</span>}
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+
+      <div className={s.front} aria-hidden>
+        <span className={s.trim} />
+        <span className={s.seal}>
+          <img src={asset('logo/logo-mark.png')} alt="" />
+        </span>
+        <span className={s.thanks}>
+          مرسی
+          <br />
+          که هستی ♥
+        </span>
+      </div>
+    </div>
+  );
+}
