diff --git a/src/components/ui/MoreShelf.module.css b/src/components/ui/MoreShelf.module.css
new file mode 100644
index 0000000000000000000000000000000000000000..0b3bff87459da22aa0b31cd9f801617f969c6f9e
--- /dev/null
+++ b/src/components/ui/MoreShelf.module.css
@@ -0,0 +1,241 @@
+/* "See all" shelf: a slow conveyor of pastry plates + a playful CTA */
+
+.shelf {
+  position: relative;
+  margin-top: 28px;
+  padding: 34px 0 40px;
+  border-radius: var(--radius-card);
+  background:
+    radial-gradient(120% 90% at 50% 120%, rgba(163, 36, 59, 0.09), transparent 60%),
+    var(--color-panel);
+  border: 1px solid var(--color-border);
+  overflow: hidden;
+  text-align: center;
+}
+
+/* Scalloped awning edge, like a bakery shop window */
+.shelf::before {
+  content: '';
+  position: absolute;
+  inset: 0 0 auto;
+  height: 14px;
+  background: radial-gradient(circle at 12px -2px, var(--color-accent) 11px, transparent 12px) 0 0 / 24px 14px repeat-x;
+  opacity: 0.9;
+}
+
+/* ---------- Conveyor ---------- */
+.belt {
+  direction: ltr;
+  padding: 18px 0 8px;
+  mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
+  -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
+}
+
+.track {
+  display: flex;
+  gap: 26px;
+  width: max-content;
+  animation: slide calc(var(--items) * 3.2s) linear infinite;
+}
+
+.shelf:hover .track {
+  animation-play-state: paused;
+}
+
+@keyframes slide {
+  to {
+    transform: translateX(-50%);
+  }
+}
+
+.plate {
+  position: relative;
+  flex: 0 0 auto;
+  width: 108px;
+  height: 108px;
+  border-radius: 50%;
+  background: radial-gradient(circle at 50% 40%, #fff, #f6e9d6 70%);
+  box-shadow:
+    0 10px 18px -12px rgba(90, 45, 30, 0.45),
+    inset 0 -4px 0 rgba(90, 45, 30, 0.06);
+  display: grid;
+  place-items: center;
+  animation: bob 2.6s ease-in-out infinite;
+  animation-delay: calc(var(--i) * -0.5s);
+  transition: transform 0.2s;
+}
+
+.plate img {
+  width: 150px;
+  height: 150px;
+  max-width: none;
+  object-fit: contain;
+  transition: transform 0.25s;
+}
+
+.plate:hover img {
+  transform: scale(1.12) rotate(-6deg);
+}
+
+@keyframes bob {
+  50% {
+    translate: 0 -7px;
+  }
+}
+
+.tag {
+  position: absolute;
+  bottom: -6px;
+  left: 50%;
+  transform: translateX(-50%) rotate(-4deg);
+  padding: 2px 9px;
+  border-radius: var(--radius-pill);
+  background: var(--color-accent);
+  color: var(--color-on-accent);
+  font-size: 10px;
+  font-weight: 700;
+  white-space: nowrap;
+  direction: rtl;
+  opacity: 0;
+  transition: opacity 0.2s;
+}
+
+.plate:hover .tag {
